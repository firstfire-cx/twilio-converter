    "express": "^5.2.1",
    "immer": "^11.1.4",
    "lucide-react": "^0.575.0",
    "mermaid": "11.13.0",
    "node-fetch": "^3.3.2",
    "papaparse": "^5.5.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "svg-pan-zoom": "^3.6.2",
